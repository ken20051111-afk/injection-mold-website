{
  "name": "yongxin-mold-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "勇鑫塑胶制品厂 - 网站与管理后台 (monorepo)",
  "workspaces": [
    "website",
    "admin"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace website",
    "dev:admin": "npm run dev --workspace admin",
    "build:website": "npm run build --workspace website",
    "build:admin": "npm run build --workspace admin",
    "build": "npm run build --workspaces",
    "start:website": "npm run start --workspace website",
    "start:admin": "npm run start --workspace admin",
    "seed": "npm run seed --workspace website"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
